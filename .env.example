# ==============================================================================
# KẾT NỐI 100% GOOGLE CLOUD CONSOLE BẰNG FILE SERVICE ACCOUNT JSON
# ==============================================================================
# Đặt file khóa JSON tải từ Google Cloud Console (IAM -> Service Accounts -> Keys)
# tại ./service-account-key.json HOẶC khai báo 1 trong 2 biến bên dưới.
# Hệ thống TỰ ĐỘNG đọc `project_id` và `client_email` ngay trong file JSON.

GOOGLE_APPLICATION_CREDENTIALS="./service-account-key.json"
# Hoặc dán nguyên chuỗi JSON vào biến môi trường (tiện cho GitHub Actions / Cloud Run):
# GCP_SA_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

GDRIVE_FOLDER_ID="your-google-drive-folder-id"

# Cấu hình vùng Vertex AI (mặc định tối ưu cho Google Cloud Console)
VERTEX_LLM_LOCATION="global"
VERTEX_IMAGEN_LOCATION="us-central1"
VERTEX_EMBEDDING_LOCATION="us-central1"

# Biến môi trường nền tảng web
APP_URL="MY_APP_URL"
