# Sao chép file này thành .env khi test local (KHÔNG commit file .env hoặc file JSON lên Git)
# Kết nối 100% Google Cloud Console bằng 1 file Service Account JSON duy nhất
# (Vertex AI + Cloud TTS + Google Drive). `project_id` được tự động đọc từ file JSON.

GOOGLE_APPLICATION_CREDENTIALS="./service-account-key.json"
GDRIVE_FOLDER_ID="your-google-drive-folder-id"

# Tùy chọn: Không cần điền nếu đã có `project_id` trong file JSON ở trên
# GCP_PROJECT_ID="your-gcp-project-id"

# Tùy chọn ghi đè cấu hình cá nhân khi chạy test
PIPELINE_LANGUAGE="vi-VN"
PIPELINE_ASPECT_RATIO="16:9"
VIDEO_VISUAL_MODE="pen_sketch"
PEN_SKETCH_PAPER_THEME="dark_slate"
TTS_PRIMARY_PROVIDER="cloud_tts"
DAILY_VIDEO_COUNT="1"
VERTEX_LLM_LOCATION="global"
VERTEX_IMAGEN_LOCATION="us-central1"
VERTEX_EMBEDDING_LOCATION="us-central1"
